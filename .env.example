# Copy to .env.local and fill in — seeds a new browser session's Settings so you
# don't have to type sp_service_id / AES key in by hand every time. Optional: the
# Settings page works fine with nothing here, you'd just fill the form manually.
FIDO_SP_SERVICE_ID=
# base64, must decode to 32 bytes (AES-256)
FIDO_AES_KEY=
# uat | prod (defaults to uat if unset)
FIDO_ENVIRONMENT=
FIDO_SP_CALLBACK_URL=
